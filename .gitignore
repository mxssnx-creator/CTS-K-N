# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/

# Private keys and environment variables
cts_key
*.pem
.ssh/
/chisel
/chisel*.log
/try_ssh.sh
/rapid_ssh.sh
.env
.env.*
!.env.example
.dca-cache/
validation-results/
.dev.vars*
!.dev.vars.example

# Common ignores
node_modules
.next/
.DS_Store
.v0-data/redis-snapshot.json
.v0-data/redis-snapshot.json.corrupt-*
.v0-data/redis-snapshot.json.*.tmp
.v0-data/redis-snapshot.json.live-wal*

# Redis/reference snapshots can contain connection metadata or credentials.
/redis*
!lib/redis-retention.ts

# Defensive: a misconfigured V0_REDIS_SNAPSHOT_PATH (e.g. a bare relative
# value/typo) can otherwise write large runtime snapshot/WAL/temp files
# directly into the repo root. The code now rejects and falls back safely,
# but keep git from ever tracking one of these loose files regardless.
/refis*
/redis-snapshot.json*
/v0-redis-snapshot.json*

# Build outputs and local runtime snapshots (never commit)
.next/
.next-release/
.next-release-check/
.next-prod/
.next-prod-final/
.next-prod-release-final/
.next-audit/
/.next-*/
.v0-dev/
.v0-prod/
.open-next/
.wrangler/
bun.lock
.cts-runtime/

# Local workspace scratch dir (never commit)
workspace/

# Local recovery artifacts and test logs are retained in the persistent
# workspace but are not source-release inputs.
.agent-logs/
.codex-backups/
.normalizer-test/
