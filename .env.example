# ─────────────────────────────────────────────────────────────────────────────
# CTS-K-N Trading Engine — Environment Variables
#
# Copy this file to .env.development.local for local development.
# For local production smoke tests with `next start`, copy to .env.production.local.
# In hosted production, configure these as encrypted Kilo/Cloudflare
# runtime values. Never commit a populated environment file.
#
# Required variables are marked [REQUIRED].
# Optional variables are marked [OPTIONAL] with their default shown.
# ─────────────────────────────────────────────────────────────────────────────


# ── Exchange API Credentials ──────────────────────────────────────────────────
# At least one exchange must be configured for the engine to place live orders.
# Live placement fails closed when credentials are absent; simulation requires
# an explicitly selected simulated/paper connection or FORCE_SIMULATED=1.
#
# PRODUCTION: Set these through the selected platform's secret manager.
# Required for /api/trade-engine/quick-start to place REAL exchange orders.
# The installer always configures live-capable mode; without valid credentials,
# runtime readiness gates fail closed and no real order is submitted.
# Never hardcode exchange credentials in source or installer scripts.

# BingX (primary exchange, bingx-x01)
BINGX_API_KEY=replace_me_bingx_api_key
BINGX_API_SECRET=replace_me_bingx_api_secret
# BingX X02 is the dedicated Prod-VST authenticated demo connection. Keep
# these distinct from X01 so virtual-funds credentials can never reach mainnet.
BINGX_X02_API_KEY=replace_me_bingx_x02_api_key
BINGX_X02_API_SECRET=replace_me_bingx_x02_api_secret
# `prod-vst` sends authenticated exchange orders against BingX Demo Trading
# with virtual VST funds. A fresh deployment starts here; set `prod-live`
# explicitly only when mainnet trading is intended.
BINGX_ENVIRONMENT=prod-vst
# Official Prod-VST origins. Authenticated demo requests are pinned to the
# dedicated VST origin, so X02 credentials cannot reach the mainnet endpoint.
BINGX_VST_ORIGIN=https://open-api-vst.bingx.com
BINGX_PUBLIC_ORIGIN=https://open-api-vst.bingx.com
BINGX_PUBLIC_FALLBACK_ORIGIN=https://open-api-vst.bingx.com

# Bybit (secondary exchange, bybit-x03)
BYBIT_API_KEY=replace_me_bybit_api_key
BYBIT_API_SECRET=replace_me_bybit_api_secret

# Pionex (optional exchange, pionex-x01)
PIONEX_API_KEY=replace_me_pionex_api_key
PIONEX_API_SECRET=replace_me_pionex_api_secret

# OrangeX (optional exchange, orangex-x01)
ORANGEX_API_KEY=replace_me_orangex_api_key
ORANGEX_API_SECRET=replace_me_orangex_api_secret


# ── Security ─────────────────────────────────────────────────────────────────

# Encryption key for sensitive data at rest (16+ random characters; 32 bytes
# recommended). The application derives an AES-256 key from this value.
# Generate: openssl rand -hex 32
# [REQUIRED in production]
ENCRYPTION_KEY=replace_me_encryption_key

# JWT secret for session tokens
# Generate: openssl rand -hex 32
JWT_SECRET=replace_me_jwt_secret

# Admin API secret for protected admin endpoints
ADMIN_SECRET=replace_me_admin_secret

# Shared bearer secret for the portable one-minute scheduler and cron routes.
# Generate: openssl rand -hex 32
# [REQUIRED for external production scheduling]
CRON_SECRET=replace_me_with_at_least_16_random_characters

# Authenticates only the installed Direct-Trade processor to its local
# control-order gateway. The server installer generates this when absent.
DIRECT_TRADE_PROCESSOR_TOKEN=replace_me_direct_trade_processor_token

# Optional independently leased Direct-Trade exception while FORCE_SIMULATED=1.
# Both values are required, and the installer rejects every ID except the exact
# virtual-funds X02 connection. `--safe-simulation` forcibly resets this to 0.
DIRECT_TRADE_LIVE_ORDER_PLACEMENT=0
DIRECT_TRADE_LIVE_CONNECTION_IDS=bingx-x02

# Exact historic warmup required when Direct-Trade enters Live mode.
# [OPTIONAL, default: 48 hours]
DIRECT_TRADE_LIVE_HISTORY_HOURS=48

# Redis inspection endpoint; requires ADMIN_SECRET bearer auth when enabled
# [OPTIONAL, default: disabled]
REDIS_DEBUG_ENABLED=0


# ── Application ───────────────────────────────────────────────────────────────

# Public URL of the app (used for absolute URLs in emails etc.)
# [OPTIONAL, defaults to localhost:3002]
NEXT_PUBLIC_APP_URL=http://localhost:3002
# [REQUIRED by deploy/runtime verification]
DEPLOYMENT_URL=http://localhost:3002

# NextAuth base URL (only if using NextAuth)
# [OPTIONAL]
NEXTAUTH_URL=http://localhost:3002

# Base URL contacted by `pnpm scheduler:minute` on serverless deployments.
# [REQUIRED for external scheduler process]
SCHEDULER_BASE_URL=http://localhost:3002


# ── Engine Control Flags ──────────────────────────────────────────────────────

# Set to "1" to force live exchange orders even in development
FORCE_LIVE=

# Set to "1" to force simulated (paper) trading regardless of credentials
FORCE_SIMULATED=

# Permit production to instantiate simulated connectors when credentials are
# intentionally absent. The Linux installer's --safe-simulation mode sets this
# together with FORCE_SIMULATED=1. The separately scoped Direct X02 setting
# above remains possible in default global-paper mode, but an explicit
# --safe-simulation installation forcibly disables it too.
ALLOW_PROD_SIMULATED=

# Direct exchange placement remains fail-closed until this is exactly "1".
# The Direct-Trade Settings page must additionally select a connection and
# enable Live execution; the installed processor token and Redis lease are
# checked for every entry/close control order.
ALLOW_LIVE_ORDER_PLACEMENT=

# Optional comma-separated global allow-list for Main/Preset/Signal exchange
# writes. The production installer pins this to the BingX Prod-VST connection;
# credentials for every other connection remain usable for read-only checks.
LIVE_ORDER_CONNECTION_IDS=bingx-x02

# The Linux production installer writes this as "1" to keep the runtime
# live-capable. Missing credentials never prevent installation, but real order
# placement remains fail-closed until credentials and all runtime gates are ready.
CTS_REQUIRE_LIVE_TRADE_READY=
CTS_LIVE_TRADING_CONFIGURED=

# Auto-start and continuity are enabled by default on a long-lived Node server.
# DISABLE_TRADE_ENGINE_AUTOSTART=1 also suppresses the in-process indication
# fallback until an external cron/operator starts work; exit-only position
# recovery stays active unless all in-process continuity is disabled. On
# stateless workers use one dedicated owner or the portable scheduler.
DISABLE_TRADE_ENGINE_AUTOSTART=
DISABLE_IN_PROCESS_CONTINUITY=
DISABLE_TRADE_ENGINE_IN_PROCESS=
CTS_DEPLOYMENT_RUNTIME=
KILO_DEPLOYMENT=

# Kilo/Cloudflare request workers cannot spawn SSH or own a permanent engine
# loop. Configure a distinct HTTPS CTS-K-N server as the long-lived owner. The
# owner secret is that server's ADMIN_SECRET and is sent only as a bearer token.
REMOTE_INSTALL_OWNER_URL=
REMOTE_INSTALL_OWNER_SECRET=replace_me_remote_install_owner_secret

# Legacy browser indication polling is development-only by default. The server
# engine and minute scheduler own production continuity.
NEXT_PUBLIC_ENABLE_BROWSER_INDICATION_CRON=

# Disable cron-driven strategy execution in production (for debugging only)
DISABLE_PROD_CRON_STRATEGIES=

# Maximum time QuickStart waits for a production engine boot before returning
# a durable queued state. Values are clamped to 1-25s so the 35s UI request
# always retains at least 10s of headroom. Default: 18000ms.
QUICKSTART_ENGINE_BOOT_WAIT_MS=

# Host self-healing checks run once per minute. A coordinated supervisor
# restarts only the failed app/scheduler/Direct-Trade service, never an
# operator-stopped installation. The cooldown avoids restart storms.
CTS_RECOVERY_COOLDOWN_SECONDS=120
# Completed cron diagnostics older than this trigger a scheduler restart.
# Must be at least 90 seconds to allow one delayed minute tick.
CTS_RECOVERY_CRON_STALE_SECONDS=150


# ── Performance Tuning ────────────────────────────────────────────────────────

# Independent realtime symbols in flight. Empty uses the CPU-aware runtime
# profile (9 logical CPUs -> 2 lanes, with control-plane reserve). Raise only
# after measuring a safe host-specific profile.
ENGINE_SYMBOL_CONCURRENCY=

# Complete realtime Base→Main→Real pipelines are scheduled fairly over this
# many symbols per event-loop tick. Default 1 keeps health/control routes
# responsive; it rotates through the whole configured basket without dropping
# any symbol, set, or historical result. Values are clamped to 1..8.
REALTIME_PIPELINE_SYMBOLS_PER_TICK=

# Detected logical CPU count and Node libuv I/O pool (normally set by installer)
CTS_CPU_COUNT=
UV_THREADPOOL_SIZE=

# Historic bootstrap symbols and continuous replay symbols in flight. Empty
# uses the same conservative CPU-aware profile as realtime.
PREHISTORIC_SYMBOL_CONCURRENCY=
PREHISTORIC_CONFIG_CONCURRENCY=
PREHISTORIC_CONFIG_TYPE_CONCURRENCY=
# Cooperative CPU scheduling for historical calculations. This changes
# responsiveness only; all candle/configuration rows are still evaluated.
PREHISTORIC_CALC_YIELD_EVERY=256
PREHISTORIC_RANGE_HOURS=
PREHISTORIC_REPLAY_SYMBOL_CONCURRENCY=
# Safe single-process default is `realtime-bridge`: after a completed current
# Realtime cycle, coalesce an accumulated Historic replay lag to the newest
# locally loaded state and expose the skipped window in Redis telemetry.
# `exact` replays every 1s candle with a full Base→Main→Real pass and should be
# used only by a capacity-tested isolated worker because it can lag indefinitely.
PREHISTORIC_REPLAY_MODE=realtime-bridge
# Full Base→Main→Real replay steps per symbol/cycle. Default is 1 to keep
# live health/control responsive; applies only to exact mode.
PREHISTORIC_REPLAY_STEPS_PER_SYMBOL=

# Independent indication Set keys/outcome groups written concurrently
INDICATION_SET_WRITE_CONCURRENCY=
INDICATION_OUTCOME_CONCURRENCY=
INDICATION_SET_READ_CONCURRENCY=
# CPU-heavy indication families in flight. Default is 1; max 4 when an
# external Redis/I/O profile has been measured to benefit from overlap.
INDICATION_SET_TYPE_CONCURRENCY=
# Complete candidate matrices yield to timers/control after this many finished
# candidates. Empty uses the latency-verified value 4; it changes scheduling
# only, never coverage.
INDICATION_CANDIDATE_YIELD_EVERY=4
# Common's synchronous calculation batch. Empty uses the latency-verified
# value 4 so UI/health/event-loop work remains responsive.
COMMON_INDICATION_CALC_BATCH_SIZE=4

# Base→Main→Real symbol graph and Preset optimizer worker pools
STRATEGY_FLOW_SYMBOL_CONCURRENCY=
# Event-loop scheduling quantum for CPU-heavy Base→Main→Real loops. Empty uses
# 64 candidates per yield on the measured host; every candidate still runs and
# remains included in complete aggregates.
STRATEGY_COOPERATIVE_YIELD_EVERY=64
# Maximum wall-clock slice between Strategy control-plane hand-offs. The
# default improves UI/health responsiveness without sampling any candidate.
STRATEGY_COOPERATIVE_TIME_SLICE_MS=8
# Maximum wall-clock slice between Common/Signal indication hand-offs.
INDICATION_COOPERATIVE_TIME_SLICE_MS=8
# Minimum routine Major-GC cadence. Per-symbol soft/hard RSS guards remain
# independent and can collect immediately under actual memory pressure.
CTS_MAINTENANCE_GC_INTERVAL_MS=120000
# Dev full-soak Young Generation; matches the installed Linux app wrapper.
DEV_NODE_SEMI_SPACE_MB=128
# Full development soak cadence; production keeps the runtime setting above.
DEV_MAINTENANCE_GC_INTERVAL_MS=30000
# Shared Strategy admission-GC debounce by pressure tier. These prevent queued
# symbols from creating a GC loop while preserving sub-second critical action.
CTS_STRATEGY_GC_ELEVATED_INTERVAL_MS=30000
CTS_STRATEGY_GC_HIGH_INTERVAL_MS=5000
CTS_STRATEGY_GC_CRITICAL_INTERVAL_MS=1000
# Number of Base Sets expanded into exact Main position-count axes per event
# loop quantum. Empty uses the Settings value (default 32); all Base/axis
# candidates remain exhaustive.
STRATEGY_AXIS_BASE_BATCH_SIZE=32
# Fields per Redis HSET transport batch for exhaustive Main fingerprint and
# Real hedge-target hashes. This never limits or samples persisted fields.
STRATEGY_REDIS_HASH_WRITE_BATCH_SIZE=256
# CPU-heavy per-Base variant construction is serial by default. Increase only
# after measuring an external-Redis/I/O profile; capped at 16 in-process.
STRATEGY_VARIANT_BUILD_CONCURRENCY=
# Bounded pseudo-position claim/write pool. Defaults to 4 and yields between
# items so large Paper books cannot block health, cron or control-order APIs.
PSEUDO_POSITION_WRITE_CONCURRENCY=
PRESET_SYMBOL_CONCURRENCY=
PRESET_CONFIG_SET_CONCURRENCY=
PRESET_COMBINATION_CONCURRENCY=
PRESET_OPTIMIZER_SYMBOL_CONCURRENCY=

# Independent Base/Main/Real symbol groups and pseudo-position updates
BASE_POSITION_SYMBOL_CONCURRENCY=
MAIN_POSITION_SYMBOL_CONCURRENCY=
REAL_POSITION_CONCURRENCY=
PSEUDO_POSITION_CONCURRENCY=
POSITION_FLOW_READ_CONCURRENCY=

# Full-history fetches kept resident at once during cold bootstrap
MARKET_DATA_LOAD_CONCURRENCY=

# Bounded realtime candle window and temporary historic chunk sizes
REALTIME_CANDLE_WINDOW=
HISTORIC_CANDLE_CHUNK_SIZE=
HISTORIC_CHUNK_READ_BATCH=
HISTORIC_CHUNK_WRITE_BATCH=

# Cap the Main-stage axis sets ceiling (override for resource-constrained envs)
STRATEGY_MAIN_AXIS_SETS_CEILING=

# Optional post-evaluation Real-row materialisation ceiling. Empty/0 is
# unlimited (production default); active exact Set lineages are always kept.
STRATEGY_REAL_SETS_CEILING=

# Max milliseconds a live position is held before forced evaluation
MAX_POSITION_HOLD_MS=


# ── Storage ───────────────────────────────────────────────────────────────────

# Production/preview shared Redis [REQUIRED]
# Configure at least one shared Redis option for production/preview deployments:
#   - REDIS_URL
#   - KV_URL
#   - UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
#   - KV_REST_API_URL + KV_REST_API_TOKEN
# InlineLocalRedis lets a production UI/paper instance boot, but it is process-local,
# can reset on worker restart, and does not unlock real exchange order placement.
# Default for the local long-lived server installed by `scripts/install.sh`.
# For Kilo/serverless use a reachable shared Redis URL instead; localhost is
# never shared between Worker instances.
REDIS_URL=redis://127.0.0.1:6379
KV_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=replace_me_upstash_redis_rest_token

# Kilo App Builder injects its managed HTTP SQLite credentials when a database
# is provisioned for the deployment. They make UI/engine state restart-safe
# across request workers. Real exchange orders remain separately fail-closed
# unless ALLOW_KILO_SQLITE_LIVE_TRADING is explicitly enabled.
DB_URL=
DB_TOKEN=replace_me_kilo_db_token
ALLOW_KILO_SQLITE_LIVE_TRADING=

# Fail closed by default. Set either flag to 1 only for a deliberately
# single-process deployment; the canonical installer configures shared Redis.
ALLOW_PROD_INLINE_REDIS=0
ALLOW_INLINE_REDIS_LIVE_TRADING=0

# Path to the Redis snapshot file (InlineLocalRedis persistence)
# Defaults to .v0-data/redis-snapshot.json relative to the project root
V0_REDIS_SNAPSHOT_PATH=

# Set to "1" to declare that V0_REDIS_SNAPSHOT_PATH is on a persistent volume.
# Required for Kilo serverless deploys using persistent inline Redis.
CTS_INLINE_REDIS_PERSISTENT_VOLUME=

# Path for automated backup exports
BACKUP_PATH=

# Number of symbols active in dev mode (overrides the default 1-symbol dev cap)
# Set to e.g. "10" to enable multi-symbol dev testing
V0_DEV_SYMBOL_COUNT=1


# ── Legacy diagnostics only ──────────────────────────────────────────────────
# CTS-K-N runtime state is Redis-backed. These old SQL diagnostic variables do
# not replace the production Redis requirement and should normally remain unset.

DATABASE_TYPE=
DB_PATH=


# ── Managed Redis REST (shared Redis option) ──────────────────────────────────
# In production/preview, this pair is one valid shared Redis option when REDIS_URL/KV_URL/Upstash REST is not set.
KV_REST_API_URL=
KV_REST_API_TOKEN=replace_me_kv_rest_api_token


# ── Kilo/Cloudflare deployment controller credentials ────────────────────────
# These authorize the local deploy controller only. scripts/kilo-deploy.mjs
# deliberately never uploads them into the Worker runtime.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=replace_me_cloudflare_api_token
